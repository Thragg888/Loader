local function setupControllableDash(char)
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local function isCoolkidd()
        local name = char.Name:lower():gsub("0", "o")
        return name:find("coolkid", 1, true) ~= nil
    end
    root.ChildAdded:Connect(function(child)
        if not child:IsA("LinearVelocity") then return end
        if not isCoolkidd() then return end
        local origDir = child.LineDirection
        local origMag = origDir.Magnitude
        local function update()
            if not controllableDashEnabled then return end
            local cam = workspace.CurrentCamera
            local dir
            if hum.MoveDirection ~= Vector3.zero then dir = hum.MoveDirection
            elseif cam then
                dir = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
                if dir.Magnitude > 0 then dir = dir.Unit end
            end
            if dir and dir.Magnitude > 0 then
                child.LineDirection = dir * origMag
                if child.LineVelocity > 0 and cam then
                    root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, root.Position + Vector3.new(dir.X, 0, dir.Z)), 0.05)
                end
            end
        end
        update()
        local c1 = hum:GetPropertyChangedSignal("MoveDirection"):Connect(update)
        local c2 = workspace.CurrentCamera and workspace.CurrentCamera:GetPropertyChangedSignal("CFrame"):Connect(update)
        child.Destroying:Once(function()
            if c1 then c1:Disconnect() end
            if c2 then c2:Disconnect() end
        end)
    end)
end
