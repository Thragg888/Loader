-- ROLE HELPERS
local function getMyKillerName()
    local PlayersFolder = Workspace:FindFirstChild("Players")
    if not PlayersFolder then return nil end
    local Killers = PlayersFolder:FindFirstChild("Killers")
    if not Killers then return nil end
    for _, model in ipairs(Killers:GetChildren()) do
        if model:IsA("Model") then
            local player = Players:GetPlayerFromCharacter(model)
            if player == lp then return model.Name end
        end
    end
    return nil
end
local function isLocalPlayerKiller() return getMyKillerName() ~= nil end

local function isHelpless()
    local char = lp.Character
    if not char then return true end
    if char:GetAttribute("Helpless") == true then return true end
    if char:GetAttribute("Stunned") == true then return true end
    if char:FindFirstChild("Helpless") or char:FindFirstChild("Stunned") then return true end
    local se = char:FindFirstChild("StatusEffects")
    if se and (se:FindFirstChild("Helpless") or se:FindFirstChild("Stunned")) then return true end
    local st = char:FindFirstChild("Status")
    if st and (st:FindFirstChild("Helpless") or st:FindFirstChild("Stunned")) then return true end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and (hum:GetAttribute("Helpless") == true or hum.Health <= 0) then return true end
    return false
end
local function isM1LockedOut()
    if not m1LockoutEnabled then return false end
    if lastM1Time == 0 then return false end
    return (tick() - lastM1Time) < M1_RECOVERY
end

