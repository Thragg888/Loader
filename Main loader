RunService.RenderStepped:Connect(function()
    local aimPunch = MyAnimLockOn or aimPunchToggles["Character Lock"]
    local camLock  = aimPunchToggles["Camera Lock"]
    if not (aimPunch or camLock) then return end
    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local camera = workspace.CurrentCamera
    if not cachedAnimator then refreshAnimator() end
    local animator = cachedAnimator
    if not animator then return end
    local folder = getKillersFolder()
    if not folder then return end
    for _, killer in ipairs(folder:GetChildren()) do
        local root = killer:FindFirstChild("HumanoidRootPart")
        if root then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local animId = tostring(track.Animation.AnimationId):match("%d+")
                if table.find(punchAnimIds, animId) then
                    local timePos = 0
                    pcall(function() timePos = track.TimePosition or 0 end)
                    if timePos <= 0.1 then
                        local humanoid = myChar:FindFirstChild("Humanoid")
                        if humanoid and aimPunch then humanoid.AutoRotate = false end
                        task.spawn(function()
                            local start = tick()
                            while tick() - start < AIM_WINDOW do
                                if myRoot and root and root.Parent then
                                    local predicted = root.Position + (root.CFrame.LookVector * predictionValue)
                                    if aimPunch then myRoot.CFrame = CFrame.lookAt(myRoot.Position, predicted) end
                                    if camLock  then camera.CFrame = CFrame.lookAt(camera.CFrame.Position, predicted) end
                                end
                                task.wait()
                            end
                            if humanoid and aimPunch then humanoid.AutoRotate = true end
                        end)
                    end
                end
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local now = tick()
    for killer, v in pairs(facingVisuals) do
        if not killer.Parent or not killer:FindFirstChild("HumanoidRootPart") then
            removeFacingVisual(killer)
        else
            local hrp = killer.HumanoidRootPart
            local center, radius = getFacingCircleInfo(hrp)
            v.Radius = radius; v.Height = 0.12
            v.CFrame = CFrame.new(0, -(hrp.Size.Y / 2 + 0.05), -(center - hrp.Position).Magnitude) * CFrame.Angles(math.rad(90), 0, 0)
            local visible = facingCheckEnabled or facingVisualOn
            v.Transparency = visible and 0.5 or 1
            if myRoot then
                local inside = (myRoot.Position - center).Magnitude <= radius
                local m1Active = m1ActiveByKiller[killer] and (now - m1ActiveByKiller[killer]) < 0.5
                if not inside then v.Color3 = Color3.fromRGB(255,255,0)
                elseif m1Active then v.Color3 = Color3.fromRGB(0,255,0)
                else v.Color3 = Color3.fromRGB(255,60,60) end
            end
        end
    end
    for killer, c in pairs(detectionCircles) do
        if c and c.Parent and killer:FindFirstChild("HumanoidRootPart") then
            local visible = killerCirclesVisible and not facingCheckEnabled
            c.Transparency = visible and 0.6 or 1
            c.Radius = detectionRange
            if myRoot and visible then
                local d = (killer.HumanoidRootPart.Position - myRoot.Position).Magnitude
                c.Color3 = d <= detectionRange and Color3.fromRGB(255,165,0) or Color3.fromRGB(255,255,0)
            end
        end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if dt <= 0 then return end
    local folder = getKillersFolder()
    if not folder then return end
    for _, k in ipairs(folder:GetChildren()) do
        local hrp = k:FindFirstChild("HumanoidRootPart")
        if hrp then
            local st = killerState[k] or { prevPos = hrp.Position, prevLook = hrp.CFrame.LookVector, angVel = 0 }
            st.vel = (hrp.Position - st.prevPos) / math.max(dt, 1e-6)
            st.prevPos = hrp.Position
            local prevLook = st.prevLook or hrp.CFrame.LookVector
            local currLook = hrp.CFrame.LookVector
            local dot      = math.clamp(prevLook:Dot(currLook), -1, 1)
            local angle    = math.acos(dot)
            local sign     = (prevLook:Cross(currLook).Y >= 0) and 1 or -1
            local rawAngVel = (angle / math.max(dt, 1e-6)) * sign
            st.angVel = (st.angVel or 0) * 0.78 + rawAngVel * 0.22
            st.prevLook = currLook
            if flickProtectionEnabled and math.abs(rawAngVel) * (180 / math.pi) > flickDegPerSecThreshold then
                flickData[k] = { lastFlickTick = tick() }
            end
            killerState[k] = st
        end
    end
end)

task.spawn(function()
    while true do
        local folder = getKillersFolder()
        if folder then
            for _, d in ipairs(folder:GetDescendants()) do
                if d:IsA("Sound") then hookSound(d) end
            end
            folder.DescendantAdded:Connect(function(d) if d:IsA("Sound") then hookSound(d) end end)
            folder.ChildAdded:Connect(function(k)
                if facingCheckEnabled or facingVisualOn then
                    task.spawn(function() task.wait(0.1); addFacingVisual(k) end)
                end
                if killerCirclesVisible and not facingCheckEnabled then
                    task.spawn(function() task.wait(0.1); addKillerCircle(k) end)
                end
            end)
            folder.ChildRemoved:Connect(function(k)
                removeFacingVisual(k); removeKillerCircle(k)
                flickData[k] = nil; m1ActiveByKiller[k] = nil
            end)
            break
        end
        task.wait(0.5)
    end
end)

