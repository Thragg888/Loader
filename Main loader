local function predictAimPos(hrp)
    if not hrp then return nil end
    if aimState.PredictMode == "Off" then return hrp.Position end
    local vel = hrp.AssemblyLinearVelocity or Vector3.new()
    if vel.Magnitude > 200 then vel = Vector3.new() end
    local usePing = matchesAny(aimCurrentAbility, AIM_PING_KEYWORDS)
    local velLead, pingLead = 0, 0
    if aimState.PredictMode == "Velocity" or aimState.PredictMode == "Both" then velLead = aimState.PredictLead end
    if usePing and (aimState.PredictMode == "Ping" or aimState.PredictMode == "Both") then
        pingLead = math.clamp(getAimPing() * 0.5 * aimState.PingMultiplier, 0, 0.5)
    end
    local totalLead = math.clamp(velLead + pingLead, 0, 0.75)
    return hrp.Position + vel * totalLead
