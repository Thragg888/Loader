function H.facing(hrp)
    local dot=math.clamp(S.facingDot or 0.3,-1,1)
    local a=math.acos(dot); local fr=a/math.pi
    local r=math.max(1,S.range*(0.20+0.80*fr))
    local fd=S.range*(0.35+0.15*fr)
    return hrp.Position+hrp.CFrame.LookVector*fd,r
end
function H.inZone(mr,kr)
    if not S.facingCheck then return (mr.Position-kr.Position).Magnitude<=S.range end
    local c,r=H.facing(kr)
    return (mr.Position-c).Magnitude<=r
end
function H.flicking(k,mr,kr)
    if not S.flickOn then return false end
    if (kr.Position-mr.Position).Magnitude>S.flickRange then return false end
    local fd=S.flickData[k]; if not fd then return false end
    return (tick()-fd.lastFlickTick)<S.flickWin
end
function H.los(tp)
    if not S.wallCheck then return true end
    local c=lp.Character; local mr=c and c:FindFirstChild("HumanoidRootPart")
    if not mr or not tp then return true end
    local rp=RaycastParams.new()
    rp.FilterType=Enum.RaycastFilterType.Exclude
    local ex={c}; local km=tp:FindFirstAncestorOfClass("Model")
    if km then table.insert(ex,km) end
    rp.FilterDescendantsInstances=ex; rp.IgnoreWater=true
    return WS:Raycast(mr.Position,tp.Position-mr.Position,rp)==nil
end
