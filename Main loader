-- AIM MODULE
local aimAssets = ReplicatedStorage:FindFirstChild("Assets")
local function norm(s) return (string.lower(tostring(s or "")):gsub("[^%a]", "")) end
local function matchesAny(name, keywords)
    local n = norm(name)
    if n == "" then return false end
    for _, kw in ipairs(keywords) do
        local k = norm(kw)
        if k ~= "" and string.find(n, k, 1, true) then return true end
    end
    return false
end
local AIM_SOUND_FIELDS = { "Sounds", "Sound", "SFX", "Sfx", "SoundEffects", "SoundIds" }
local function pushIdsFromValue(value, intoSet, name)
    if type(value) == "string" or type(value) == "number" then
        local id = tostring(value):match("%d+")
        if id then intoSet[id] = name end
    elseif type(value) == "table" then
        for _, v in pairs(value) do pushIdsFromValue(v, intoSet, name) end
    end
end
local function readAimConfig(module)
    local ok, cfg = pcall(require, module)
    if not ok or type(cfg) ~= "table" then return end
    if type(cfg.Animations) == "table" then
        for key, value in pairs(cfg.Animations) do pushIdsFromValue(value, aimAbilityAnimIds, key) end
    end
    for _, f in ipairs(AIM_SOUND_FIELDS) do
        local t = cfg[f]
        if type(t) == "table" then
            for key, value in pairs(t) do pushIdsFromValue(value, aimAbilitySoundIds, key) end
        end
    end
end
local function loadAimIds(char)
    aimAbilityAnimIds, aimAbilitySoundIds = {}, {}
    if not aimAssets or not char then return end
    local charName = char:GetAttribute("CharacterName") or char.Name
    local skinName = char:GetAttribute("SkinName") or "Default"
    local surv = aimAssets:FindFirstChild("Survivors")
    local sf   = surv and surv:FindFirstChild(charName)
    if sf then
        local c = sf:FindFirstChild("Config")
        if c then readAimConfig(c) end
    end
    if skinName ~= "Default" then
        local sk  = aimAssets:FindFirstChild("Skins")
        local ss  = sk and sk:FindFirstChild("Survivors")
        local sc  = ss and ss:FindFirstChild(charName)
        local skf = sc and sc:FindFirstChild(skinName)
        if skf then
            local c = skf:FindFirstChild("Config")
            if c then readAimConfig(c) end
        end
    end
end
local function aimPushEvent(ability)
    aimEventRefCount += 1
    aimEventActive = true
    aimCurrentAbility = ability
end
local function aimPopEvent()
    aimEventRefCount = math.max(0, aimEventRefCount - 1)
    if aimEventRefCount == 0 then
        aimEventActive = false
        aimCurrentAbility = nil
    end
end
local function resolveAbilityFromAnim(animId, animName)
    if animId then
        local fromCfg = aimAbilityAnimIds[animId]
        if fromCfg and matchesAny(fromCfg, AIM_KEYWORDS) then return fromCfg end
    end
    if animName and matchesAny(animName, AIM_KEYWORDS) then return animName end
    return nil
end
local function resolveAbilityFromSound(soundId, soundName)
    if soundId then
        local fromCfg = aimAbilitySoundIds[soundId]
        if fromCfg and matchesAny(fromCfg, AIM_KEYWORDS) then return fromCfg end
    end
    if soundName and matchesAny(soundName, AIM_KEYWORDS) then return soundName end
    return nil
end
local function attachAimAnimWatcher(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local animator = hum:WaitForChild("Animator", 5)
    if not animator then return end
    animator.AnimationPlayed:Connect(function(track)
