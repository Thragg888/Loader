function F.doGens(on)
    for _,obj in ipairs(WS:GetDescendants()) do
        if obj.Name=="Generator" then
            if on then F.attachGen(obj)
            else
                local h=obj:FindFirstChild("esp_g"); if h then h:Destroy() end
                local b=obj:FindFirstChild("esp_g_bb"); if b then b:Destroy() end
                if S.genConns[obj] then S.genConns[obj]:Disconnect(); S.genConns[obj]=nil end
            end
        end
    end
end
function F.startInvis()
    S.invisOn=true
