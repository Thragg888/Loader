-- FACING MATH
local function getFacingCircleInfo(killerHRP)
    local dot   = math.clamp(customFacingDot or 0.3, -1, 1)
    local angle = math.acos(dot)
    local frac  = angle / math.pi
    local radius      = math.max(1, detectionRange * (0.20 + 0.80 * frac))
    local forwardDist = detectionRange * (0.35 + 0.15 * frac)
    local center      = killerHRP.Position + killerHRP.CFrame.LookVector * forwardDist
    return center, radius
end
local function isInBlockZone(myRoot, killerHRP)
    if not facingCheckEnabled then return (myRoot.Position - killerHRP.Position).Magnitude <= detectionRange end
    local center, radius = getFacingCircleInfo(killerHRP)
    return (myRoot.Position - center).Magnitude <= radius
end

-- FLICK
local function isKillerFlicking(killer, myRoot, killerHRP)
    if not flickProtectionEnabled then return false end
    if (killerHRP.Position - myRoot.Position).Magnitude > flickRange then return false end
    local fd = flickData[killer]
    if not fd then return false end
    return (tick() - fd.lastFlickTick) < flickWindow
end

-- HDT
local function beginDragIntoKiller(killerModel)
    if isLocalPlayerKiller() then return end
    if _hitboxDraggingDebounce then return end
    if not killerModel or not killerModel.Parent then return end
    local char = lp and lp.Character
    if not char then return end
    local hrp      = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    local targetHRP = getKillerHRP(killerModel)
    if not targetHRP then return end
    _hitboxDraggingDebounce = true
    local oldAutoRotate = humanoid.AutoRotate
    pcall(function() humanoid.AutoRotate = false end)
    local bv = Instance.new("BodyVelocity")
    bv.Name = "HDT_BV"; bv.MaxForce = Vector3.new(8e4, 0, 8e4); bv.Velocity = Vector3.new(0, 0, 0); bv.Parent = hrp
    local bg = Instance.new("BodyGyro")
    bg.Name = "HDT_Gyro"; bg.MaxTorque = Vector3.new(4e5, 4e5, 4e5); bg.D = 100; bg.P = 3000; bg.Parent = hrp
    local speed = Dspeed or 8
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not _hitboxDraggingDebounce then
            conn:Disconnect()
            if bv and bv.Parent then pcall(function() bv:Destroy() end) end
            if bg and bg.Parent then pcall(function() bg:Destroy() end) end
            if humanoid then pcall(function() humanoid.AutoRotate = oldAutoRotate end) end
            return
        end
        if not (char and char.Parent) or not (killerModel and killerModel.Parent) then _hitboxDraggingDebounce = false; return end
        local t = getKillerHRP(killerModel)
        if not t then _hitboxDraggingDebounce = false; return end
        if bg and bg.Parent then
            pcall(function() bg.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(t.Position.X, hrp.Position.Y, t.Position.Z)) end)
        end
        local toTarget = t.Position - hrp.Position
        local horiz = Vector3.new(toTarget.X, 0, toTarget.Z)
        if horiz.Magnitude <= 2.0 then _hitboxDraggingDebounce = false; return end
        local dir = horiz.Unit
        bv.Velocity = Vector3.new(dir.X * speed, bv.Velocity.Y, dir.Z * speed)
    end)
    task.delay(HDT_DURATION, function() if _hitboxDraggingDebounce then _hitboxDraggingDebounce = false end end)
end

