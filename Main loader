local function findConfigKey(cfg, name, seen)
    if type(cfg) ~= "table" then return nil end
    seen = seen or {}
    if seen[cfg] then return nil end
    seen[cfg] = true
    for k, v in pairs(cfg) do
        if type(k) == "string" and k:find(name, 1, true) and not k:find(name .. "OG", 1, true) then
            return k, cfg
        end
        if type(v) == "table" then
            local fk, fp = findConfigKey(v, name, seen)
            if fk then return fk, fp end
        end
    end
    return nil
end
local function applyNoliVoidRush(mode)
    if not noliConfig then return false end
    local preset = (mode ~= "Off") and NOLI_MODES[mode] or nil
    for key, defaultVal in pairs(NOLI_VOID_RUSH_DEFAULTS) do
        local fk, fp = findConfigKey(noliConfig, key)
        if fk and fp then
            if fp[fk .. "OG"] == nil then fp[fk .. "OG"] = fp[fk] end
            if preset then fp[fk] = preset[key]
            else fp[fk] = fp[fk .. "OG"] or defaultVal end
        end
    end
    return true
end
task.spawn(function()
    local Assets = ReplicatedStorage:FindFirstChild("Assets")
    if not Assets then return end
    local Killers = Assets:FindFirstChild("Killers")
    if not Killers then return end
    local function tryLoad(folder)
        if not folder then return false end
        local Config = folder:FindFirstChild("Config")
        if not Config then return false end
        local ok, cfg = pcall(require, Config)
        if ok and type(cfg) == "table" and findConfigKey(cfg, "InitialTurnMult") then
            noliConfig = cfg; return true
        end
        return false
    end
    local loaded = tryLoad(Killers:FindFirstChild("Noli"))
    if not loaded then
        for _, killer in ipairs(Killers:GetChildren()) do
            if tryLoad(killer) then loaded = true; break end
        end
    end
    if loaded and noliVoidRushMode ~= "Off" then applyNoliVoidRush(noliVoidRushMode) end
end)

