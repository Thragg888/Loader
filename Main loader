-- Compatible label updater across Rayfield versions
local function updateLabel(elem, text)
    if not elem then return end
    local str = tostring(text)
    pcall(function()
        if typeof(elem) == "Instance" then
            elem.Text = str
        elseif elem.Element then
            if typeof(elem.Element) == "Instance" then
                elem.Element.Text = str
            elseif elem.Element.TextLabel then
                elem.Element.TextLabel.Text = str
            end
        end
        if elem.Set then elem:Set(str) end
    end)
end

