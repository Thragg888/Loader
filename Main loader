end
function F.hl(m,col,list)
    if not m or not m:FindFirstChild("HumanoidRootPart") then return end
    local h=Instance.new("Highlight")
    h.Adornee=m; h.FillColor=col; h.OutlineColor=col
    h.FillTransparency=0.65; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent=m; table.insert(list,h)
end
function F.itemHl(item)
    if not (item:IsA("BasePart") or item:IsA("Model")) then return end
    local n=item.Name
    local isM=(n=="Medkit" and S.espMed)
    local isB=(n=="BloxyCola" and S.espBloxy)
    if not (isM or isB) then return end
    local t=item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
    if not t or t:FindFirstChild("ItemHighlight") then return end
    local h=Instance.new("Highlight")
    h.Name="ItemHighlight"; h.Adornee=item
    h.FillTransparency=0.5; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    if isM then h.FillColor=Color3.fromRGB(255,105,180); h.OutlineColor=h.FillColor
    else h.FillColor=Color3.fromRGB(0,150,255); h.OutlineColor=h.FillColor end
