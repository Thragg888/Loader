-- Clean ability fire (no IIFE, no forward-reference bugs)
local function fireAbility(name)
    if not name or name=="" or not remote then return end
    pcall(function()
        local bytes={3,#name,0,0,0}
        for i=1,#name do table.insert(bytes,string.byte(name,i)) end
        local buf=buffer.create(#bytes)
        for i=1,#bytes do buffer.writeu8(buf,i-1,bytes[i]) end
        remote:FireServer("UseActorAbility",{buf})
    end)
end

-- HELPERS
function H.isHelpless()
    local c=lp.Character; if not c then return true end
    if c:GetAttribute("Helpless")==true or c:GetAttribute("Stunned")==true then return true end
    if c:FindFirstChild("Helpless") or c:FindFirstChild("Stunned") then return true end
    local se=c:FindFirstChild("StatusEffects")
    if se and (se:FindFirstChild("Helpless") or se:FindFirstChild("Stunned")) then return true end
    local st=c:FindFirstChild("Status")
    if st and (st:FindFirstChild("Helpless") or st:FindFirstChild("Stunned")) then return true end
    local h=c:FindFirstChildOfClass("Humanoid")
    if h and (h:GetAttribute("Helpless")==true or h.Health<=0) then return true end
    return false
end
function H.m1Locked()
    if not S.m1Lockout or S.lastM1==0 then return false end
    return (tick()-S.lastM1)<S.M1_RECOVERY
end
function H.killers()
    local p=WS:FindFirstChild("Players")
    return p and p:FindFirstChild("Killers")
end
function H.nearest()
    local mr=lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return nil end
    local f=H.killers(); if not f then return nil end
    local best,bd=nil,math.huge
    for _,k in ipairs(f:GetChildren()) do
        local hrp=k:FindFirstChild("HumanoidRootPart")
        if hrp then
            local d=(hrp.Position-mr.Position).Magnitude
            if d<bd then best=k; bd=d end
        end
    end
    return best
end
function H.khrp(m)
    if not m then return nil end
    return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart",true)
end
function H.myKiller()
    local p=WS:FindFirstChild("Players"); if not p then return nil end
    local k=p:FindFirstChild("Killers"); if not k then return nil end
    for _,m in ipairs(k:GetChildren()) do
        if m:IsA("Model") and Players:GetPlayerFromCharacter(m)==lp then return m.Name end
    end
    return nil
end
function H.isSupported(n) return n and IDS.parryKillers[n:lower()] or false end
function H.abilityFor(n) return n and IDS.parryAbilities[n:lower()] end
function H.others()
    local list={}
    local p=WS:FindFirstChild("Players"); if not p then return list end
    for _,fn in ipairs({"Survivors","Killers"}) do
