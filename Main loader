-- FEATURES
function F.beginDrag(km)
    if S.hdtDebounce or not km or not km.Parent then return end
    local c=lp.Character; if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart")
    local hum=c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    if not H.khrp(km) then return end
    S.hdtDebounce=true
    local oldAR=hum.AutoRotate
    pcall(function() hum.AutoRotate=false end)
    local bv=Instance.new("BodyVelocity")
    bv.MaxForce=Vector3.new(8e4,0,8e4); bv.Velocity=Vector3.new(); bv.Parent=hrp
    local bg=Instance.new("BodyGyro")
    bg.MaxTorque=Vector3.new(4e5,4e5,4e5); bg.D=100; bg.P=3000; bg.Parent=hrp
    local spd=S.Dspeed or 8
    local conn
    conn=Run.Heartbeat:Connect(function()
        if not S.hdtDebounce then
            conn:Disconnect()
            if bv.Parent then pcall(function() bv:Destroy() end) end
            if bg.Parent then pcall(function() bg:Destroy() end) end
            pcall(function() hum.AutoRotate=oldAR end)
            return
        end
        if not (c and c.Parent) or not (km and km.Parent) then S.hdtDebounce=false; return end
        local t=H.khrp(km); if not t then S.hdtDebounce=false; return end
        pcall(function() bg.CFrame=CFrame.lookAt(hrp.Position,Vector3.new(t.Position.X,hrp.Position.Y,t.Position.Z)) end)
        local toT=t.Position-hrp.Position
        local hor=Vector3.new(toT.X,0,toT.Z)
        if hor.Magnitude<=2 then S.hdtDebounce=false; return end
        local dir=hor.Unit
        bv.Velocity=Vector3.new(dir.X*spd,bv.Velocity.Y,dir.Z*spd)
    end)
    task.delay(S.HDT_DUR,function() S.hdtDebounce=false end)
end
function F.isSurv()
    local c=lp.Character; if not c then return false end
    local p=c.Parent; return p and p.Name=="Survivors"
end
function F.nearestKHRP(maxD)
    local mr=lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return nil end
    local f=H.killers(); if not f then return nil end
    local best,bd=nil,maxD or 500
    for _,k in ipairs(f:GetChildren()) do
        if k:IsA("Model") then
            local hrp=k:FindFirstChild("HumanoidRootPart")
            local h=k:FindFirstChildOfClass("Humanoid")
            if hrp and h and h.Health>0 then
                local d=(hrp.Position-mr.Position).Magnitude
                if d<bd then best=hrp; bd=d end
            end
        end
    end
    return best,bd
end
function F.triggerStab()
    if not S.sStabOn or S.sStabActive then return end
    if tick()-S.sStabLast<S.sStabCD then return end
    local mr=lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not mr then return end
    local kr=F.nearestKHRP(S.sStabRange); if not kr then return end
    local killer=kr.Parent
    S.sStabActive=true; S.sStabLast=tick()
    local kcf=kr.CFrame
    local bp=kcf.Position-kcf.LookVector*S.sStabBehind
    local origin=mr.CFrame
    local behind=CFrame.lookAt(Vector3.new(bp.X,origin.Position.Y,bp.Z),Vector3.new(kcf.Position.X,origin.Position.Y,kcf.Position.Z))
    if S.sStabTeleDelay>0 then task.wait(S.sStabTeleDelay) end
    local cur=lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not cur then S.sStabActive=false; return end
    cur.CFrame=behind
    pcall(function() cur.AssemblyLinearVelocity=Vector3.new() end)
    if S.sStabConn then pcall(function() S.sStabConn:Disconnect() end) end
    local hum=lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    S.sStabOldAR=hum and hum.AutoRotate or true
    if hum then hum.AutoRotate=false end
    local endT=tick()+S.sStabFollow
    S.sStabConn=Run.RenderStepped:Connect(function()
        if tick()>=endT or not S.sStabActive then
            if S.sStabConn then pcall(function() S.sStabConn:Disconnect() end); S.sStabConn=nil end
            if hum then hum.AutoRotate=S.sStabOldAR end
            S.sStabActive=false; return
        end
        local ch=lp.Character; local m2=ch and ch:FindFirstChild("HumanoidRootPart")
        if not m2 then S.sStabActive=false; return end
        local k2=killer and killer:FindFirstChild("HumanoidRootPart")
        if not k2 or not k2.Parent then S.sStabActive=false; return end
        local c2=k2.CFrame
        local b2=c2.Position-c2.LookVector*S.sStabBehind
        local tcf=CFrame.lookAt(Vector3.new(b2.X,m2.Position.Y,b2.Z),Vector3.new(c2.Position.X,m2.Position.Y,c2.Position.Z))
        m2.CFrame=m2.CFrame:Lerp(tcf,0.5)
        pcall(function() m2.AssemblyLinearVelocity=Vector3.new() end)
    end)
end
