RunService.Heartbeat:Connect(function()
    if not killerAutoParryEnabled then return end
    local myKiller = getMyKillerName()
    if not isSupportedKiller(myKiller) then
        setKillerParryStatus(myKiller and ("Not supported: " .. myKiller) or "Not a killer")
        return
    end
    setKillerParryStatus("Active as " .. myKiller)
    if tick() - killerParryLastTime < killerParryCooldown then return end
    local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    local ability = abilityForKiller(myKiller)
    if not ability then return end
    for _, char in ipairs(getSurvivorCharacters()) do
        local tgtRoot = char:FindFirstChild("HumanoidRootPart")
        if tgtRoot and (tgtRoot.Position - myRoot.Position).Magnitude <= killerParryRange then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    if not killerParryTrackSeen[track] then
                        local animId = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
                        local animName = ""
                        pcall(function() animName = track.Animation and track.Animation.Name or "" end)
                        local matchedId   = animId and killerParryAnimIds[animId]
                        local matchedName = nameMatchesParryKeyword(animName)
                        if matchedId or matchedName then
                            killerParryTrackSeen[track] = true
                            killerParryLastTime = tick()
                            setKillerParryLastLabel(char.Name .. " / " .. (animId or "?") .. (matchedName and (" (name:" .. animName .. ")") or "") .. " → " .. ability)
                            if killerParryDelay > 0 then
                                task.delay(killerParryDelay, function() fireKillerAbility(ability) end)
                            else
                                fireKillerAbility(ability)
                            end
                            break
                        end
                    end
                end
            end
        end
    end
end)

